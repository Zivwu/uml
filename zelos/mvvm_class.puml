abstract class Lifecycle extends ChangeNotifier implements WidgetsBindingObserver{
  -bool _hasHiddenState
  +void dispose()
  +void didChangeAppLifecycleState()
  +void onAppForeground()
  +void onAppBackground()
  +void onReady()
  +void onResumed()
  +void onInactive()
  +void onDispose()
  +void onHidden()
}


class ViewModel extends Lifecycle{
  +String tag
  +T logicState
  +ZStatusBasePageState uiState
  +BuildContext context
  +dynamic analysisParams()
  +dynamic argumentsAlreadyOK()
  +dynamic onViewModelInit()
  +T createState()
  +dynamic requestNetData()
  +dynamic errorNetData()
  +dynamic hideKeyboard()
  .. ZAppLifecycle ..
  +void onReady()
  +void onResumed()
  +void onHidden()
  +void onAppForeground()
  +void onAppBackground()
  +void onInactive()
  +void onDispose()
}
